# Urai configuration — copy to .env and edit.
#
#   cp .env.example .env
#
# Loaded automatically by `urai api`, `urai studio` and the desktop app
# (current directory first, then the repo root). Values already exported in
# your shell always win. Use $URAI_ENV_FILE=/path/to/file to read another file.

# ── Core ─────────────────────────────────────────────────────────────────────
URAI_PORT=8777
URAI_MODEL=qwen3-4b

# REQUIRED when listening beyond localhost. Generate:
#   openssl rand -hex 32
URAI_MASTER_KEY=

# Extra gate for /v1/*, /chat, /agent, … when exposing the API.
# Leave empty on a single-user localhost install.
URAI_API_KEY=

# CORS origin for browser clients. "*" is convenient locally; set your exact
# origin in production (e.g. https://app.example.com).
URAI_CORS_ORIGIN=*

# ── Limits ───────────────────────────────────────────────────────────────────
URAI_RATE_LIMIT=60          # requests per window per IP (0 = disabled)
URAI_RATE_WINDOW=60         # window length in seconds
URAI_REQUEST_TIMEOUT=120    # per-request timeout in seconds
URAI_FREE_LIMIT=5           # guest requests per device/IP before blocking
URAI_BLOCK_SECONDS=1800     # block duration for exhausted guests

# ── Storage / logging ────────────────────────────────────────────────────────
# URAI_DATA_DIR=./data
# URAI_LOG_FILE=./urai.log

# ── Local model servers ──────────────────────────────────────────────────────
JEV_LLAMA_URL=http://127.0.0.1:8080
URAI_EMBED_URL=http://127.0.0.1:8081

# ── Optional cloud providers (Urai runs fully without these) ─────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_BASE_URL=
AWS_DEFAULT_REGION=ap-south-1

# ── Remote CLI mode ──────────────────────────────────────────────────────────
# URAI_REMOTE_URL=https://your-urai-host
# URAI_REMOTE=1
# URAI_DEVICE_ID=
