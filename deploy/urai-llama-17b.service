[Unit]
Description=Urai llama-server Qwen3-1.7B (distill teacher, :8082)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=urai
WorkingDirectory=/opt/urai
ExecStart=/opt/urai/third_party/llama.cpp/build/bin/llama-server -m model/base/Qwen3-1.7B-Q4_K_M.gguf --host 127.0.0.1 --port 8082 -c 2048 -t 2 -fa on --no-webui
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
