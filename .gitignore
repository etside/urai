# Urai — binaries and local build outputs stay out of git.
# Everything else (source, docs, seed + verified data, reports, registry)
# is tracked so the repo holds the complete project.
*.gguf
*.bin
third_party/
__pycache__/
*.pyc
.nox/
.venv/
*.log
/tmp/
*.db
*.db-shm
*.db-wal
*auth*.json
opencode-migration-backup-*/
*.safetensors
data/token_state.json
data/api_tokens.json
data/sessions/
data/sched_runs/

# Runtime state written by the Studio / CLI (not project content)
data/agents/
data/routines.json
data/workspace/

# Desktop build output
desktop/node_modules/
desktop/dist/

# Python / test caches
.pytest_cache/
.ruff_cache/
/build/
/dist/


# Tool-guard audit log
jev/data/
